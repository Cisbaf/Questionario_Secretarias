# Backend (QuestionarioBackEnd) — todas opcionais em desenvolvimento; os padrões abaixo já funcionam
# com o MySQL do docker-compose da raiz do IdeaProjects (porta 3307).
SERVER_PORT=8082
DB_PORT=3307
DB_NAME=questionario
DB_USER=root
DB_PASSWORD=root
CORS_ALLOWED_ORIGINS=http://localhost:3002

# Capa do questionário (levantamento). O backend as grava no banco a cada subida.
# Datas no formato AAAA-MM-DD; deixe em branco para aparecer "a definir" na capa.
# Data fora do formato ou período invertido (fim antes do início) impede o backend de subir.
LEVANTAMENTO_TITULO=Questionário às Secretarias Municipais de Saúde
LEVANTAMENTO_PERIODO_INICIO=
LEVANTAMENTO_PERIODO_FIM=
LEVANTAMENTO_DATA_CENSO=
LEVANTAMENTO_PRAZO_DEVOLUCAO=
LEVANTAMENTO_ENVIAR_PARA=

# Frontend (QuestionarioFrontEnd/.env): onde o Next repassa as chamadas /api.
# BACKEND_INTERNAL_URL=http://localhost:8082/api
