# Copie para ".env" (ao lado do docker-compose.yml) e preencha. NÃO commite o .env.
DOCKERHUB_USER=seu_usuario_no_docker_hub
TAG=latest

# Endereço público do site (sem barra no final). Usado no CORS do backend.
PUBLIC_URL=https://questionario.suaorg.gov.br
FRONT_PORT=3002

# MySQL do servidor
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=questionario
DB_USER=questionario
DB_PASSWORD=troque-esta-senha

# Admin (obrigatórios). JWT_SECRET: 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
ADMIN_EMAIL=admin@suaorg.gov.br
ADMIN_PASSWORD=troque-esta-senha-tambem
JWT_SECRET=
# true se o site abre por HTTPS; false se for HTTP puro (rede interna sem certificado)
COOKIE_SEGURO=true

# Capa do questionário
LEVANTAMENTO_TITULO=Questionário às Secretarias Municipais de Saúde
LEVANTAMENTO_PERIODO_INICIO=
LEVANTAMENTO_PERIODO_FIM=
LEVANTAMENTO_DATA_CENSO=
LEVANTAMENTO_PRAZO_DEVOLUCAO=
LEVANTAMENTO_ENVIAR_PARA=
